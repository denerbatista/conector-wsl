{
  "name": "claude-wsl-terminal-connector",
  "version": "0.6.0",
  "description": "MCP connector that exposes a controlled WSL terminal and filesystem to Claude/Cowork, with zero-config auto-detection.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "src/index.js",
  "bin": {
    "claude-wsl-terminal-connector": "src/index.js"
  },
  "files": [
    ".claude-plugin",
    ".mcp.json",
    "src",
    "server",
    "scripts/postinstall.js",
    "scripts/preuninstall.js",
    "manifest.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "scripts/sync-version.js"
  ],
  "scripts": {
    "start": "node ./src/index.js",
    "postinstall": "node scripts/postinstall.js",
    "preuninstall": "node scripts/preuninstall.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"*.json\" \"*.md\"",
    "package": "npm run bundle && bash scripts/pack.sh",
    "prepublishOnly": "npm run lint && npm test",
    "version": "node scripts/sync-version.js && git add src/version.js manifest.json .claude-plugin/plugin.json",
    "bundle": "esbuild src/index.js --bundle --platform=node --target=node20 --format=esm --outfile=dist/wsl-connector.mjs --log-level=warning"
  },
  "keywords": [
    "anthropic",
    "claude",
    "cowork",
    "filesystem",
    "mcp",
    "wsl"
  ],
  "license": "MIT",
  "author": "Dener Batista",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denerbatista/conector-wsl.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "esbuild": "^0.24.2",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "vitest": "^2.1.8"
  },
  "homepage": "https://denerbatista.github.io/conector-wsl/"
}
